# Copy to .env (gitignored) and export the values in your shell. Nothing here is required
# for the local-model experiments except OLLAMA_HOST if Ollama is not on the default port.

# Ollama server (default shown)
OLLAMA_HOST=http://127.0.0.1:11434
# Where Ollama stores model weights (set before starting the Ollama service)
OLLAMA_MODELS=D:\Ollama\models

# Hugging Face cache (datasets and embedding models)
HF_HOME=D:\.cache\huggingface

# Optional hosted readers. Leave unset to run local models only; keys are read from the
# environment at call time and never written to results/.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
